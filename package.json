{
  "name": "autopsia-rn",
  "version": "0.5.0",
  "description": "Stop new architecture violations in React Native / TypeScript. Configurable dependency rules, legacy baselines, CI checks and offline visual reports.",
  "bin": {
    "autopsia": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "README.es.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanBenito12/Autopsia.git"
  },
  "bugs": {
    "url": "https://github.com/SanBenito12/Autopsia/issues"
  },
  "homepage": "https://sanbenito12.github.io/Autopsia/",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/build.cjs",
    "test:package": "node scripts/test-package.cjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test && npm run test:package",
    "scan:fixture": "tsx src/index.ts scan fixtures/sample-app --config fixtures/sample-app/autopsia.config.json",
    "scan:alias": "tsx src/index.ts scan fixtures/alias-app --config fixtures/alias-app/autopsia.config.json",
    "demo:html": "tsx src/index.ts scan fixtures/sample-app --config fixtures/sample-app/autopsia.config.json --html demo/report.html",
    "demo:walkthrough": "node scripts/demo-walkthrough.cjs"
  },
  "keywords": [
    "clean-architecture",
    "react-native",
    "static-analysis",
    "architecture",
    "lint",
    "ast",
    "typescript",
    "cli",
    "dependency-graph",
    "architecture-testing"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "d3": "^7.9.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
